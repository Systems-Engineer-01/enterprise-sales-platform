// ============================================================
// Enterprise Sales Platform
// Database Schema
// PostgreSQL 18 + Prisma ORM 7
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
}

// ============================================================
// IDENTITY & ACCESS
// ============================================================

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  status    UserStatus @default(ACTIVE)

  userRoles UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]          @relation("PurchaseCreatedBy")
  sales     Sale[]              @relation("SaleCreatedBy")
  movements InventoryMovement[]
  auditLogs AuditLog[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  status      CategoryStatus @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  price       Decimal       @db.Decimal(12, 2)
  cost        Decimal       @db.Decimal(12, 2)
  status      ProductStatus @default(ACTIVE)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

// ============================================================
// COMMERCIAL PARTNERS
// ============================================================

model Customer {
  id        String         @id @default(uuid())
  document  String         @unique
  firstName String
  lastName  String
  email     String?
  phone     String?
  status    CustomerStatus @default(ACTIVE)

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("customers")
}

model Supplier {
  id           String         @id @default(uuid())
  document     String         @unique
  businessName String
  email        String?
  phone        String?
  status       SupplierStatus @default(ACTIVE)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("suppliers")
}

// ============================================================
// INVENTORY
// ============================================================

model Warehouse {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  status      WarehouseStatus @default(ACTIVE)

  inventories        Inventory[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("warehouses")
}

model Inventory {
  id          String  @id @default(uuid())
  warehouseId String
  productId   String
  quantity    Decimal @default(0) @db.Decimal(14, 3)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("inventory")
}

model InventoryMovement {
  id          String                @id @default(uuid())
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(14, 3)
  productId   String
  warehouseId String
  userId      String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ============================================================
// PURCHASES
// ============================================================

model Purchase {
  id         String         @id @default(uuid())
  supplierId String
  createdBy  String
  status     PurchaseStatus @default(DRAFT)
  total      Decimal        @default(0) @db.Decimal(14, 2)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user     User     @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Decimal @db.Decimal(14, 3)
  unitCost   Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(14, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ============================================================
// SALES
// ============================================================

model Sale {
  id         String     @id @default(uuid())
  customerId String
  createdBy  String
  status     SaleStatus @default(DRAFT)
  total      Decimal    @default(0) @db.Decimal(14, 2)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user     User     @relation("SaleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(14, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
