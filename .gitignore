.env
.env.*
!.env.example

# Dependencies
**/node_modules/

# Build artifacts
**/dist/
**/build/
**/generated/

# Test / Coverage
**/coverage/

# Logs
**/*.log

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
